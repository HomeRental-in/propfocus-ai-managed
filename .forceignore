package.xml

# LWC configuration files
**/jsconfig.json
**/.eslintrc.json

# LWC Jest
**/__tests__/**

node_modules/

# Connected app Propfocus_AI was dropped from the package (forceignored since
# ~v0.4). Managed packages cannot restore a deleted component. Including it
# again fails version create with: Installing an app that has been deleted.
# Inbound JWT uses a subscriber-org External Client App instead (see JWT_SETUP).
force-app/main/default/connectedApps/
# Org-specific JWT External Client App (created in subscriber orgs, not packaged)
force-app/main/default/externalClientApps/
# Custom notification type must stay in the managed package (cannot remove without Partner case)
# force-app/main/default/notificationtypes/
