# List files or directories below to ignore them when running force:source:push, force:source:pull, and force:source:status
# More information: https://developer.salesforce.com/docs/atlas.en-us.sfdx_dev.meta/sfdx_dev/sfdx_dev_exclude_source.htm
#

package.xml

# LWC configuration files
**/jsconfig.json
**/.eslintrc.json

# LWC Jest
**/__tests__/**

node_modules/

# NOTE: connectedApps must NOT be forceignored — .forceignore also applies to
# `sf package version create`, so ignoring it silently drops the packaged
# PropFocus AI connected app (JWT inbound auth) from every package version.
# For source deploys to subscriber sandboxes, deploy targeted metadata instead
# of the whole force-app tree.
# Org-specific JWT External Client App (created in subscriber orgs, not packaged)
force-app/main/default/externalClientApps/
# Custom notification type must stay in the managed package (cannot remove without Partner case)
# force-app/main/default/notificationtypes/
