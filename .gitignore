.tmp-uat*/

# Dev-only retrieve / cleanup manifests (not part of package source)
manifest/cleanup-local-duplicates/
manifest/cleanup-uninstall/
manifest/retrieve-check/
manifest/retrieve-csp/
manifest/retrieve-uninstall/
manifest/temp-retrieve/
manifest/temp-retrieve2/

